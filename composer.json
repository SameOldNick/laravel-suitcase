{
  "name": "sameoldnick/laravel-suitcase",
  "description": "Laravel apps, ready for shared hosting.",
  "license": "MIT",
  "keywords": [
    "laravel",
    "shared hosting",
    "deployment",
    "bundler",
    "packager",
    "upload",
    "cpanel",
    "directadmin"
  ],
  "authors": [
    {
      "name": "Nick Hamnett",
      "email": "nick@sameoldnick.com",
      "homepage": "https://www.sameoldnick.com/",
      "role": "Developer"
    }
  ],
  "homepage": "https://github.com/sameoldnick/laravel-suitcase",
  "require": {
    "php": "^8.1",
    "ext-zip": "*",
    "composer/semver": "^3.4",
    "ifsnop/mysqldump-php": "^2.12",
    "illuminate/console": "^10.2|^11.0|^12.0|^13.0",
    "illuminate/database": "^10.2|^11.0|^12.0|^13.0",
    "illuminate/support": "^10.2|^11.0|^12.0|^13.0",
    "spatie/db-dumper": "^3.8",
    "symfony/console": "^6.4.1|^7.0"
  },
  "require-dev": {
    "larastan/larastan": "^2.7|^3.0",
    "laravel/pint": "^1.22",
    "mockery/mockery": "^1.6.7",
    "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0",
    "phpstan/extension-installer": "^1.3.1",
    "phpunit/phpunit": "^10.0 || ^11.0"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "SameOldNick\\LaravelSuitcase\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SameOldNick\\LaravelSuitcase\\Tests\\": "tests"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  },
  "extra": {
    "laravel": {
      "providers": [
        "SameOldNick\\LaravelSuitcase\\ServiceProvider"
      ]
    }
  },
  "scripts": {
    "analyse": "vendor/bin/phpstan analyse",
    "baseline": "vendor/bin/phpstan analyse --generate-baseline",
    "test": "vendor/bin/phpunit",
    "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
    "build": "@php vendor/bin/testbench workbench:build --ansi",
    "artisan": "@php vendor/bin/testbench --ansi"
  }
}
